# Скопируйте в apps/api/.env:  cp apps/api/.env.example apps/api/.env

DATABASE_URL="postgresql://expense:expense@localhost:5433/expense_tracker?schema=public"

# 4001, а не 4000: 4000 занят контейнером другого проекта
PORT=4001
CORS_ORIGIN=http://localhost:3001

# Секреты обязательно заменить своими значениями (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d
