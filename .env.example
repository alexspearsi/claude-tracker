# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Значения ниже используются docker-compose для локальной БД.

POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
# 5433, а не 5432: на этой машине 5432 уже занят локально установленным PostgreSQL
POSTGRES_PORT=5433
